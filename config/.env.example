# Salin file ini menjadi ".env" (di folder yang sama), lalu isi nilainya.
# JANGAN upload file ".env" ke GitHub. Di Vercel/hosting: isi di Environment Variables.

# ---- Supabase (wajib) ----
# URL: Supabase > Project Settings > Data API  (tanpa /rest/v1/, tanpa garis miring di akhir)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Key: Supabase > Project Settings > API Keys > Secret keys (diawali sb_secret_)
SUPABASE_KEY=sb_secret_xxxxxxxx

# ---- Panel admin (wajib untuk buka /admin) ----
ADMIN_PASSWORD=ganti-dengan-password-kuat
# String acak panjang untuk menandatangani cookie login admin (boleh dikosongkan)
APP_SECRET=

# ---- Midtrans (opsional: bayar online otomatis QRIS/VA/e-wallet/kartu) ----
# Daftar gratis di https://dashboard.midtrans.com > Settings > Access Keys
# Kosongkan kalau tidak dipakai; opsi "Bayar Online" otomatis disembunyikan.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# false = Sandbox (uji coba), true = Production (uang sungguhan)
MIDTRANS_PRODUCTION=false
